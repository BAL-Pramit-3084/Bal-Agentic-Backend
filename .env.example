# =============================================================================
# BALASORE ALLOYS DASHBOARD SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL Database Configuration
# -----------------------------------------------------------------------------
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=balcorpdb

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# Default guest access duration (days)
DEFAULT_GUEST_DAYS=7

# -----------------------------------------------------------------------------
# Claude AI Configuration
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-api03-your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://your-frontend-url

# -----------------------------------------------------------------------------
# Chatbot Configuration
# -----------------------------------------------------------------------------
# Tables the chatbot can query (comma-separated)
ALLOWED_CHATBOT_TABLES=balcorpdb.kpi_furnace_oper_summary,balcorpdb.kpi_furnace_tapping_clock

# Tables to block from chatbot (comma-separated, leave empty for none)
BLACKLIST_TABLES=

# -----------------------------------------------------------------------------
# Flask Configuration (Optional)
# -----------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=0

# -----------------------------------------------------------------------------
# Logging Configuration (Optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Server Configuration (Optional)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=5100

# -----------------------------------------------------------------------------
# Voice Feature (TTS/STT) - OpenAI Realtime Voice
# -----------------------------------------------------------------------------
# Uses the same OPENAI_API_KEY defined above for AI features

# Enable/disable voice feature (true/false)
VOICE_ENABLED=true

# TTS (Text-to-Speech) Configuration - OpenAI TTS API
# Available voices: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=alloy
# Available models: tts-1 (faster), tts-1-hd (higher quality)
OPENAI_TTS_MODEL=tts-1
# Response format: mp3, opus, aac, flac, wav, pcm
OPENAI_TTS_FORMAT=mp3
# Speech speed: 0.25 to 4.0 (default: 1.0)
OPENAI_TTS_SPEED=1.0

# STT (Speech-to-Text) Configuration - OpenAI Whisper API
# Model: whisper-1
OPENAI_STT_MODEL=whisper-1
# Default language (optional, auto-detect if not set)
# Use ISO-639-1 format: en, hi, bn, ta, te, etc.
OPENAI_STT_LANGUAGE=